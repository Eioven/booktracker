# ===== Базовые URL =====
# URL фронтенда, куда стучатся тесты (Vite dev-server по умолчанию слушает 5173)
BASE_URL=http://127.0.0.1:5173

# URL бэкенда для прямых API-вызовов из фикстур
API_URL=http://127.0.0.1:8000

# ===== Параметры запуска =====
# Включить запись видео и скриншотов даже для успешных тестов (true/false)
DEBUG_ARTIFACTS=false

# Headless-режим: true (по умолчанию) или false для визуального дебага
HEADLESS=true

# Количество параллельных воркеров локально (CI задаёт своё)
WORKERS=4

# ===== Allure =====
# Имя окружения, попадающее в отчёт Allure
ALLURE_ENVIRONMENT=local

# ===== Веб-сервер =====
# Если true — playwright сам поднимет фронт и бэк через webServer
# В CI всегда true, локально можно выставить false и держать серверы открытыми вручную
START_WEB_SERVERS=true
